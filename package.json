{
  "name": "laci",
  "version": "1.0.0",
  "private": true,
  "description": "A file manager that knows which folders are projects, and keeps their agent history attached when they move.",
  "type": "module",
  "engines": {
    "node": ">=23.6"
  },
  "scripts": {
    "start": "electron electron/main.mjs",
    "serve": "node src/server.ts",
    "ls": "node src/cli.ts",
    "doctor": "node src/cli.ts doctor",
    "json": "node src/cli.ts json",
    "proto": "node src/cli.ts proto",
    "test": "node --test --test-timeout=60000 test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "web": "node src/server.ts --open",
    "mcp": "node src/mcp.ts"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.2.0",
    "@types/node": "^26.6.3",
    "electron": "^44.4.5",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.2.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "dompurify": "^3.4.16",
    "marked": "^18.0.14",
    "node-pty": "^1.1.0",
    "zod": "^4.6.5"
  }
}
